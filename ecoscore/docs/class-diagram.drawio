ve(Object)\n+ Object update(Object,Object)\n+ Boolean delete(Object)\n}\n\n\nclass QuizDAO {\n+ QuizTO save(Object)\n+ QuizTO update(Object,Object)\n+ Boolean delete(Object)\n+ ArrayList&lt;Object&gt; findAll()\n+ QuizTO findById(Object)\n}\n\nclass UsuarioTO {\n- String idUsuario\n- String nmUsuario\n- float vlMerito\n- int qtSoulCoins\n- String dsAtividadeRecente\n- String selosGanhos\n+ String getNmUsuario()\n+ void setNmUsuario(String)\n+ String getIdUsuario()\n+ void setIdUsuario(String)\n+ float getVlMerito()\n+ void setVlMerito(float)\n+ int getQtSoulCoins()\n+ void setQtSoulCoins(int)\n+ String getDsAtividadeRecente()\n+ void setDsAtividadeRecente(String)\n+ String getSelosGanhos()\n+ void setSelosGanhos(String)\n+ void registrarAtividade(String)\n+ void registrarAtividade(String,int)\n+ void registrarAtividade(String,int,String)\n+ String detalhesPerfil()\n+ String registrarPenalidade(float,String)\n}\n\n\nclass AcaoTO {\n- Integer idAcao\n- String idUsuario\n- String dsAcao\n- int qtPontosGerados\n- LocalDateTime dtAcao\n+ Integer getIdAcao()\n+ void setIdAcao(Integer)\n+ String getIdUsuario()\n+ void setIdUsuario(String)\n+ String getDsAcao()\n+ void setDsAcao(String)\n+ int getQtPontosGerados()\n+ void setQtPontosGerados(int)\n+ LocalDateTime getDtAcao()\n+ void setDtAcao(LocalDateTime)\n+ int registrarPontos(int)\n+ String detalhesAcao()\n}\n\n\nclass UsuarioController {\n+ String inserirUsuario(String,String,float,int,String,String)\n+ String alterarUsuario(String,String,float,int,String,String)\n+ String excluirUsuario(String)\n+ ArrayList&lt;Object&gt; listarTodosUsuario()\n+ UsuarioTO pegarUmUsuario(String)\n}\n\nclass MissaoDAO {\n+ MissaoTO save(Object)\n+ MissaoTO update(Object,Object)\n+ Boolean delete(Object)\n+ ArrayList&lt;Object&gt; findAll()\n+ MissaoTO findById(Object)\n}\n\nclass PostTO {\n- Integer idPost\n- String idUsuario\n- String dsPost\n- LocalDateTime dtPost\n- int numUpVotes\n- int numDownVotes\n- int numSaldoVotes\n+ Integer get